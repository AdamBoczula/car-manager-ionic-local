{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "workspaces": {
    ".": {
      "entry": [
        "apps/car-manager/src/main.ts",
        "apps/car-manager/scripts/seed-dev.ts",
        "apps/car-manager-e2e/src/**/*.spec.ts",
        "eslint.config.mjs"
      ],
      "project": ["apps/car-manager/src/**/*.ts", "apps/car-manager-e2e/src/**/*.ts"],
      "ignore": [
        "apps/car-manager/capacitor.config.ts",
        "apps/car-manager/src/environments/environment.example.ts",
        "apps/car-manager/src/environments/environment.prod.example.ts",
        "apps/car-manager/src/environments/environment.prod.ts",
        "**/*.spec.backup.ts",
        "**/node_modules/**",
        "**/dist/**",
        "**/.angular/**",
        "**/coverage/**"
      ],
      "ignoreDependencies": [
        "@capacitor/core",
        "@capacitor/android",
        "@capacitor/ios",
        "@capacitor-community/speech-recognition",
        "@ionic/core",
        "@nx/workspace",
        "@nx/angular",
        "@nx/devkit",
        "@nx/eslint",
        "@nx/eslint-plugin",
        "@nx/js",
        "@nx/vite",
        "@nx/web",
        "@nx/playwright",
        "@angular-devkit/build-angular",
        "@angular/build",
        "@angular/cli",
        "@angular/compiler-cli",
        "@angular/language-service",
        "firebase-tools",
        "@capacitor/cli",
        "jsdom",
        "@eslint/eslintrc"
      ]
    }
  }
}
