{
  "name": "car-manager-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/car-manager-e2e/src",
  "implicitDependencies": ["car-manager"],
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx playwright test --config apps/car-manager-e2e/playwright.config.ts"
      }
    },
    "a11y": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx playwright test --config apps/car-manager-e2e/playwright.config.ts --grep @a11y"
      }
    }
  }
}
