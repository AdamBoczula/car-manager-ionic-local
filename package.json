{
  "name": "car-manager",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/setup-environments.js",
    "start": "nx serve car-manager",
    "build": "nx build car-manager",
    "lint": "nx lint car-manager",
    "lint:all": "nx run-many -t lint",
    "lint:strict": "nx run-many -t lint --maxWarnings=0",
    "e2e": "npx playwright test",
    "a11y": "npx playwright test --grep @a11y",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "static:checks": "npm run lint && npm run format:check",
    "knip": "npx knip --no-config-hints",
    "duplication": "npx jscpd --config .jscpd.json",
    "quality": "npm run static:checks && npm run knip && npm run duplication"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@ionic/angular": "^9.0.10",
    "@ionic/core": "^9.0.10",
    "@ionic/storage": "^4.0.0",
    "firebase": "^13.1.0",
    "ionicons": "^7.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.9.4",
    "@analogjs/vitest-angular": "^2.9.4",
    "@angular-devkit/build-angular": "^22.2.5",
    "@angular-eslint/eslint-plugin": "^22.6.0",
    "@angular-eslint/eslint-plugin-template": "^22.6.0",
    "@angular-eslint/template-parser": "^22.6.0",
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@angular/language-service": "^22.2.4",
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/cli": "^8.6.0",
    "@eslint/eslintrc": "^3.3.7",
    "@nx/angular": "^24.0.3",
    "@nx/devkit": "^24.0.3",
    "@nx/eslint": "^24.0.3",
    "@nx/eslint-plugin": "^24.0.3",
    "@nx/js": "^24.0.3",
    "@nx/playwright": "^24.0.3",
    "@nx/vite": "^24.0.3",
    "@nx/web": "^24.0.3",
    "@nx/workspace": "^24.0.3",
    "@playwright/test": "^1.64.1",
    "@testing-library/angular": "^19.6.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.0.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "firebase-tools": "^15.34.2",
    "jscpd": "^5.4.2",
    "jsdom": "^30.1.3",
    "knip": "^6.44.1",
    "nx": "^24.0.3",
    "prettier": "^3.5.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "nx@24.0.3": true,
    "esbuild@0.28.2": true,
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.6": true,
    "msgpackr-extract@3.0.4": true,
    "@parcel/watcher@2.6.0": true,
    "lmdb@3.5.6": true,
    "re2@1.27.0": true
  }
}
