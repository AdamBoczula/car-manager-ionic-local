{
  "threshold": 8,
  "reporters": ["console", "html"],
  "output": "docs/quality/duplication",
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.angular/**",
    "**/coverage/**",
    "**/*.spec.ts",
    "**/*.spec.backup.ts",
    "**/test-setup.ts",
    "**/capacitor.config.ts",
    "**/environments/*.ts"
  ],
  "absolute": true,
  "min-lines": 10,
  "min-tokens": 70,
  "max-lines": 500,
  "pattern": "apps/car-manager/src/**/*.ts"
}
